{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studyai-news-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "development",
    "RELEASE_VERSION": "0.1.0"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "studyai-news-api-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "RELEASE_VERSION": "0.1.0"
      }
    },
    "production": {
      "name": "studyai-news-api",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "RELEASE_VERSION": "0.1.0"
      }
    }
  }
}
