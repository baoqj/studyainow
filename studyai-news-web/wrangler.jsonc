{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studyai-news-web-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "services": [
    {
      "binding": "NEWS_API",
      "service": "studyai-news-api-dev"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "RELEASE_VERSION": "0.1.0"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "studyai-news-web-staging",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "none"
      },
      "services": [
        {
          "binding": "NEWS_API",
          "service": "studyai-news-api-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "RELEASE_VERSION": "0.1.0"
      }
    },
    "production": {
      "name": "studyai-news-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "news.studyai.now",
          "custom_domain": true
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "none"
      },
      "services": [
        {
          "binding": "NEWS_API",
          "service": "studyai-news-api"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "RELEASE_VERSION": "0.1.0"
      }
    }
  }
}
