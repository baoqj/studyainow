---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical = Astro.url.href, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f9f9ff" />
    <meta property="og:site_name" content="Study AI Now! News" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('studyai-theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch {}
    </script>
  </head>
  <body>
    <header class="global-header">
      <div class="global-header-inner">
        <a class="brand" href="https://studyai.now/" aria-label="Study AI Now 首页">
          <span class="brand-symbol" aria-hidden="true">S</span>
          <span class="wordmark"><span>Study</span><span>AI</span><span>Now!</span></span>
        </a>
        <nav class="desktop-nav" aria-label="全站导航">
          <a href="https://studyai.now/">AI课程</a>
          <a href="https://studyai.now/interviews">面试题集</a>
          <a href="https://studyai.now/jobs">工作机会</a>
          <a class="active" href="/" aria-current="page">新闻</a>
          <a href="https://studyai.now/me/resume">简历制作</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题"><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
          <a class="login-link" href="https://studyai.now/login">登录</a>
        </div>
      </div>
      <nav class="mobile-nav" aria-label="移动端全站导航">
        <a href="https://studyai.now/">AI课程</a><a href="https://studyai.now/interviews">面试题集</a><a href="https://studyai.now/jobs">工作机会</a><a class="active" href="/" aria-current="page">新闻</a><a href="https://studyai.now/me/resume">简历制作</a>
      </nav>
    </header>
    <slot />
    <footer class="global-footer">
      <div><strong>Study AI Now!</strong><span>把可信 AI 新闻连接到可学习、可练习的能力。</span></div>
      <nav aria-label="页脚导航"><a href="/">新闻首页</a><a href="/articles">已发布文章</a><a href="https://studyai.now/about">关于我们</a><a href="https://studyai.now/privacy">隐私政策</a><a href="mailto:studyainow@mail.com">联系我们</a></nav>
      <small>© 2026 Study AI Now! · News v0.4.0</small>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('studyai-theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
